# ─── SmartStress AI — Template des variables d'environnement ───────────────
# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS committer .env sur Git

# ── Base de données MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartstress
DB_USER=smartstress_user
DB_PASS=your_password_here

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# ── Clé API Groq (LLM ChillBot) ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Pour le dashboard Vite (préfixe VITE_ obligatoire)
VITE_GROQ_KEY=your_groq_api_key_here

# ── MySQL root (Docker uniquement) ───────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword_here
